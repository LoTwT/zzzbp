{
  "name": "zzzbp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "pnpm run typecheck && cf build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "cf workers types && vue-tsc -b",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "measure:rooms": "vitest run -c vitest.measure.config.ts",
    "generate:agent-catalog": "node scripts/generate-agent-catalog.ts",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@lucide/vue": "^1.50.0",
    "@vueuse/core": "^15.0.0",
    "reka-ui": "^2.10.5",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ayingott/theme": "^0.3.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@cloudflare/vitest-plugin": "1.3.6",
    "@randomplay/data": "0.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "cf": "1.0.0-beta.12",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "playwright": "1.63.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx,vue}": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.6.0"
}
